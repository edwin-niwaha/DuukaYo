# Django
DJANGO_ENV=development
SECRET_KEY=development-only-replace-with-a-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Browser-facing admin link shown to platform administrators in the web dashboard.
PUBLIC_ADMIN_URL=http://localhost:8000/admin/

# PostgreSQL: DATABASE_URL wins when set; otherwise use DB_*.
DB_NAME=duukayo
DB_USER=duukayo
DB_PASSWORD=duukayo_dev
DB_HOST=127.0.0.1
DB_PORT=55432
DATABASE_URL=

# Celery / Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_DEFAULT_QUEUE=perpetual-pos

# Google sign-in: public web client IDs, not client secrets.
GOOGLE_KEY=
MOBILE_GOOGLE_CLIENT_IDS=
# Optional additional trusted client IDs; GOOGLE_KEY is always included.
GOOGLE_CLIENT_IDS=
# Retained for compatibility; not used by ID-token sign-in.
GOOGLE_SECRET=

# Firebase push: enable explicitly; base64 takes precedence over the JSON file.
PUSH_BACKEND=log
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_B64=

# Email: console for development; choose django.core.mail.backends.smtp.EmailBackend to use SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DuukaYo <noreply@localhost>

# Reserved borrowed settings: these integrations are not implemented in this app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GITHUB_KEY=
GITHUB_SECRET=
SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CALLBACK_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Legacy/local media: retain MEDIA_ROOT while migrating existing files to Cloudinary.
# Set PUBLIC_MEDIA_ORIGIN to the HTTPS media host (or shared LAN API origin in development).
MEDIA_ROOT=
MEDIA_URL=/media/
PUBLIC_MEDIA_ORIGIN=

# Cloudinary console > Settings > API keys. Backend secrets only.
MEDIA_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
