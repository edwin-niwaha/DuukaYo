{
  "expo": {
    "name": "DuukaYo",
    "slug": "duukayo-mobile",
    "scheme": "duukayo",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.duukayo.ug",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
