EXPO_PUBLIC_APP_ENV=development
# Android emulator; use your PC LAN IP for a physical phone.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1/
EXPO_PUBLIC_API_TIMEOUT_MS=15000

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android OAuth registration reference; native sign-in selects it by package/signing certificate.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Put machine-specific SDK values in .env.local, not .env:
# ANDROID_HOME=C:/Users/your-user/AppData/Local/Android/Sdk
