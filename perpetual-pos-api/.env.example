DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=development-only-replace-with-a-long-random-value
DATABASE_URL=postgresql://perpetual:perpetual_dev@127.0.0.1:55432/perpetual_pos
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CSRF_TRUSTED_ORIGINS=http://localhost:3000
PUSH_BACKEND=log
# For a configured server only: PUSH_BACKEND=fcm
